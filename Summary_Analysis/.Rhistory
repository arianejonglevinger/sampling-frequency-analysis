filter(!BMP_Category %in% exclude_BMPCats) %>%
# also exclude data from National Storm Water Database (updated 6/12/26)
filter(BMP_Category != "Not Applicable") # n = 16,585 (# subsets * 5 quantiles)
subset_stats <- data_BMPCat_s %>%
select(N, Rain_Zone, Location, Analyte, Flow, BMP_Category, BMP_Category_long, NumObservations) %>%
distinct() # 3,317
# format data for use in statistical analysis of Coefficient of Variation (see
# CompareCVBetweenGroups.R)
cv_BMPType <- data_BMPCat_s %>%
select(Rain_Zone, Location, Analyte, Flow, BMP_Category, BMP_Category_long,
coefficientOfVariation, NumObservations) %>%
distinct()
# save coeff. of variation data w/ BMP Type
#write.csv(cv_BMPType, "Coefficient of Variation for Parent Datasets with Metadata_20260612.csv", row.names = FALSE)
########### Create sample size tables ##########################################
# create table of sample sizes by BMP Category
nPar_BMPType <- cv_BMPType %>%
group_by(BMP_Category_long, BMP_Category) %>%
summarise(n_parent_datasets = n(), n_observations = sum(NumObservations))
# save as CSV
#write.csv(nPar_BMPType, here::here("Data", "Number of Parent Datasets by BMP Type_20260616.csv"), row.names = FALSE)
# Analyte & BMP Category
nPar_BMPType_Analyte <- cv_BMPType %>%
group_by(BMP_Category_long, BMP_Category, Analyte) %>%
summarise(n_parent_datasets = n(), n_observations = sum(NumObservations))
# Flow Type & Analyte & BMP Category
nPar_BMPType_Analyte_Flow <- cv_BMPType %>%
group_by(BMP_Category_long, BMP_Category, Analyte, Flow) %>%
summarise(n_parent_datasets = n(), n_observations = sum(NumObservations))
# 4/24/26: create inventory of parent datasets (updated 6/3/26 after removing
#irrelevant BMP Categories)
## remove subset rows
parent_only_d <- data_BMPCat_s %>%
select(Rain_Zone, Location, Analyte, Flow, NumObservations, smallerCountBins) %>%
distinct() # originally 834 parent datasets, 723 after removing bad BMP Cats
# format parent metadata
metadata_fmt <- metadata %>%
rename(Flow = Flow_Type) %>%
select(-Rain_Zone)
metadata_rz_fix <- left_join(metadata_fmt, rain_zone_mapping, by = "Location")
parent_w_BMPCat <- left_join(parent_only_d, metadata_rz_fix,
by = c("Location", "Analyte", "Flow", "Rain_Zone")) %>%
# reorder columns
select(Rain_Zone, BMP_Category, Location:smallerCountBins)
# table: number of parent datasets by Rain Zone, BMP_Category, Analyte, and Flow type
n_parent_summ_tbl <- parent_w_BMPCat %>%
group_by(Rain_Zone, BMP_Category, Analyte, Flow) %>%
summarise(n_parent_datasets = n())
# save as CSV
#write.csv(n_parent_summ_tbl, here::here("Data", "Number of Parent Datasets by RZ_BMPType_Analyte_FlowType_20260612.csv"), row.names = FALSE)
# check # parent datasets
sum(n_parent_summ_tbl$n_parent_datasets)
# check # parent datasets with N>20 and N>25
N_gt20_25 <- parent_w_BMPCat %>%
mutate(N_cat = case_when(
NumObservations > 25 ~ "N > 25",
NumObservations > 20 & NumObservations <= 25 ~ "N > 20",
.default = "N = 20"
)) %>%
group_by(N_cat) %>%
summarise(N = n()) %>%
mutate(pct = N/723*100)
# table: number of observations by Location, BMP_Category, Analyte, and Flow type
parent_w_BMPCat_fmt <- parent_w_BMPCat %>%
arrange(Rain_Zone, BMP_Category, Analyte, Flow)
# save as CSV
#write.csv(parent_w_BMPCat_fmt, here::here("Data", "Number of Observations per Parent Dataset_with BMPType_20260612.csv"), row.names = FALSE)
# table: count of parent datasets by categories for Number of Events in Parent Dataset
n_parent_by_NumEventBin <- parent_only_d %>%
group_by(Analyte, smallerCountBins) %>%
summarise(n_parent = n())
# save as CSV
#write.csv(n_parent_by_NumEventBin, here::here("Data", "Number of Parent Datasets by Plot Category_20260612.csv"), row.names = FALSE)
######## Make Final Figures ####################################################
### Mean RPD by sample size of parent dataset and sample size of random subset
# and by Analyte, Flow type, and EMC percentile
# first, identify which subsets of RPDs can be grouped together as 1 curve
# instead of being plotted as curves by sample size of parent dataset using
# Kruskal-Wallis test
# create separate facets for Phosphorus:Inflow and Phosphorus:Outflow
P_flow_s <- data_BMPCat_s %>%
filter(Analyte == "Phosphorus") %>%
# create facet group == Analyte + Flow
mutate(facet_group = paste0(Analyte, ": ", Flow)) %>%
# create npar_gt90 group == facet_group + whether smallerCountBins == ">90"
mutate(npar_gt90 = case_when(
smallerCountBins == ">90" ~ ">90",
.default = "20-90"
)) %>%
# drop Flow column for joining with other data
select(-Flow) %>%
# format grouping vars
mutate(N_numerical = factor(N_numerical, levels = c(5, 10, 15, 20, 25))) %>%
mutate(Quartile = factor(Quartile, levels = c(0.1, 0.25, 0.5, 0.75, 0.9))) %>%
select(N_numerical, Quartile, smallerCountBins, Analyte, facet_group, npar_gt90, NumObservationsBelowDetect, NumObservations, rpd)
Cu_TSS_s <- data_BMPCat_s %>%
filter(Analyte != "Phosphorus") %>%
# create facet group == Analyte
mutate(facet_group = Analyte) %>%
# create npar_gt90 group == facet_group + whether smallerCountBins == ">90"
mutate(npar_gt90 = case_when(
smallerCountBins == ">90" ~ ">90",
.default = "20-90"
)) %>%
# format grouping vars
mutate(N_numerical = factor(N_numerical, levels = c(5, 10, 15, 20, 25))) %>%
mutate(Quartile = factor(Quartile, levels = c(0.1, 0.25, 0.5, 0.75, 0.9))) %>%
select(N_numerical, Quartile, smallerCountBins, Analyte, facet_group, npar_gt90, NumObservationsBelowDetect, NumObservations, rpd)
data_BMPCat_s_fg <- rbind(P_flow_s, Cu_TSS_s) %>%
# format facet group
mutate(facet_group = factor(facet_group, levels = c("Copper", "Phosphorus: Inflow",
"Phosphorus: Outflow", "TSS"))) %>%
# format npar_gt90 group
mutate(npar_gt90 = factor(npar_gt90, levels = c(
"20-90",
">90"
)))
# FACET GROUPS: initialize empty output table for Kruskall-Wallis test
facet_groups <- unique(data_BMPCat_s_fg$facet_group)
n_fg <- length(facet_groups)
percentiles <- unique(data_BMPCat_s_fg$Quartile)
n_pctl <- length(percentiles)
kw_p_tbl <- tibble(
Facet_Group = character(),
Percentile = character(),
KrusWal_pvalue = numeric()
)
# loop over facet groups
for (i in 1:n_fg) {
fg_s <- data_BMPCat_s_fg %>%
filter(facet_group == facet_groups[i])
for (j in 1:n_pctl) {
pctl_s <- fg_s %>%
filter(Quartile == percentiles[j])
# run Kruskal-Wallis test for significant differences b/w groups (non-parametric)
kw_result <- kruskal.test(rpd ~ smallerCountBins, data = pctl_s)
# save results in output table
kw_p_tbl <- kw_p_tbl %>%
add_row(Facet_Group = facet_groups[i],
Percentile = percentiles[j],
KrusWal_pvalue = kw_result$p.value)
}
}
# identify significant comparisons (p < 0.05)
kw_p_tbl_w_sig <- kw_p_tbl %>%
mutate(sig_label = case_when(
KrusWal_pvalue < 0.05 ~ "Significant",
.default = "Not Significant"
)) %>%
arrange(Facet_Group, Percentile)
# Not Significant:
# Facet_Group        Percentile KrusWal_pvalue sig_label
# 1 Copper             0.5                0.254  Not Significant
# 2 Copper             0.75               0.117  Not Significant
# 3 Copper             0.9                0.0646 Not Significant
# 4 Phosphorus: Inflow 0.1                0.838  Not Significant
# 5 Phosphorus: Inflow 0.25               0.495  Not Significant
# FACET GROUPS n_par > 90: initialize empty output table for Kruskall-Wallis test
facet_groups <- unique(data_BMPCat_s_fg$facet_group)
n_fg <- length(facet_groups)
npar_gt90s <- unique(data_BMPCat_s_fg$npar_gt90)
percentiles <- unique(data_BMPCat_s_fg$Quartile)
n_pctl <- length(percentiles)
kw_p_fg90_tbl <- tibble(
Facet_Group = character(),
Percentile = character(),
KrusWal_pvalue = numeric()
)
# loop over facet subsample groups
for (i in 1:n_fg) {
fg_s <- data_BMPCat_s_fg %>%
filter(facet_group == facet_groups[i])
for (j in 1:n_pctl) {
pctl_s <- fg_s %>%
filter(Quartile == percentiles[j])
# run Kruskal-Wallis test for significant differences b/w groups (non-parametric)
kw_result <- kruskal.test(rpd ~ npar_gt90, data = pctl_s)
# save results in output table
kw_p_fg90_tbl <- kw_p_fg90_tbl %>%
add_row(Facet_Group = facet_groups[i],
Percentile = percentiles[j],
KrusWal_pvalue = kw_result$p.value)
}
}
# identify significant comparisons (p < 0.05)
kw_p_fg90_tbl_w_sig <- kw_p_fg90_tbl %>%
mutate(sig_label = case_when(
KrusWal_pvalue < 0.05 ~ "Significant",
.default = "Not Significant"
)) %>%
arrange(Facet_Group, Percentile)
# Not Significant:
# Facet_Group        Percentile KrusWal_pvalue sig_label
# 1 Copper             0.5                0.0855 Not Significant
# 2 Phosphorus: Inflow 0.1                0.901  Not Significant
# 3 Phosphorus: Inflow 0.25               0.168  Not Significant
# instead of using K-W results, choose which to plot as 1 curve using visual
# inspection of difference between Mean RPD for each sample size for random
# subset and parent dataset
### plot with all analytes
# --- 1. Define which facet_group × Quartile combinations should show the median ---
aggregate_pairs <- tribble(
~facet_group,          ~Quartile,
"Copper", 0.25, # added for plot using npar_gt90
"Copper", 0.5,
"Copper", 0.75,
"Phosphorus: Inflow", 0.25,
"Phosphorus: Inflow", 0.5,
"Phosphorus: Inflow", 0.75,
"Phosphorus: Outflow", 0.25,
"Phosphorus: Outflow", 0.5,
"Phosphorus: Outflow", 0.75  # added for plot using npar_gt90
# add as many rows as needed
)
# --- 2. Tag rows that belong to an aggregate panel ---
data_tagged <- data_BMPCat_s %>%
select(N_numerical, Quartile, smallerCountBins, Analyte, Flow, rpd) %>%
# create facet group (Analyte + Flow for Phosphorus, Analyte for Copper & TSS)
mutate(facet_group = case_when(
Analyte == "Phosphorus" ~ paste0(Analyte, ": ", Flow),
.default = Analyte
)) %>%
mutate(aggregate = interaction(facet_group, Quartile) %in%
interaction(aggregate_pairs$facet_group, aggregate_pairs$Quartile)) %>%
# format grouping vars so they plot in the correct order
mutate(N_numerical = factor(N_numerical, levels = c(5, 10, 15, 20, 25))) %>%
mutate(Quartile = factor(Quartile, levels = c(0.1, 0.25, 0.5, 0.75, 0.9))) %>%
mutate(facet_group = factor(facet_group, levels = c("Copper", "Phosphorus: Inflow",
"Phosphorus: Outflow", "TSS")))
data_tagged_gt90 <- data_BMPCat_s_fg %>%
select(N_numerical, Quartile, smallerCountBins, Analyte, facet_group, npar_gt90, rpd) %>%
mutate(aggregate = interaction(facet_group, Quartile) %in%
interaction(aggregate_pairs$facet_group, aggregate_pairs$Quartile)) %>%
# format grouping vars so they plot in the correct order
mutate(N_numerical = factor(N_numerical, levels = c(5, 10, 15, 20, 25))) %>%
mutate(Quartile = factor(Quartile, levels = c(0.1, 0.25, 0.5, 0.75, 0.9))) %>%
mutate(facet_group = factor(facet_group, levels = c("Copper", "Phosphorus: Inflow",
"Phosphorus: Outflow", "TSS")))
# --- 3. Subset by aggregate_pairs and calculate mean and SD ---
aggregated_data <- data_tagged %>%
filter(aggregate) %>%
group_by(N_numerical, Quartile, facet_group) %>%
summarise(
sd  = sd(rpd, na.rm = TRUE),
n = n(),
rpd = mean(rpd, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(smallerCountBins = "All bins")
aggregated_data_gt90 <- data_tagged_gt90 %>%
filter(aggregate) %>%
group_by(N_numerical, Quartile, facet_group, npar_gt90) %>%
summarise(
sd  = sd(rpd, na.rm = TRUE),
n = n(),
rpd = mean(rpd, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(smallerCountBins = npar_gt90) %>%
# drop npar_gt90 column for joining
select(-npar_gt90)
# --- 4. Subset by non-aggregate panels and calculate mean and SD ---
pergroup_data <- data_tagged %>%
filter(!aggregate) %>%
group_by(N_numerical, Quartile, facet_group, smallerCountBins) %>%
summarise(
sd  = sd(rpd, na.rm = TRUE),
n = n(),
rpd = mean(rpd, na.rm = TRUE),
.groups = "drop"
)
# --- 5. Combine ---
bin_levels <- c("20-30", "31-60", "61-90", ">90", "All bins")
bin_levels_gt90 <- c("20-30", "31-60", "61-90", ">90", "20-90")
plot_data <- bind_rows(pergroup_data, aggregated_data) %>%
mutate(smallerCountBins = factor(smallerCountBins, levels = bin_levels))
plot_data_gt90 <- bind_rows(pergroup_data, aggregated_data_gt90) %>%
mutate(smallerCountBins = factor(smallerCountBins, levels = bin_levels_gt90))
# query results for writing about in manuscript
tss_s <- plot_data_gt90 %>%
filter(facet_group=="TSS") %>%
filter(smallerCountBins==">90")
cu_s <- plot_data_gt90 %>%
filter(facet_group=="Copper") %>%
filter(smallerCountBins==">90")
tp_s <- plot_data_gt90 %>%
filter(str_detect(facet_group, "Phosphorus")) %>%
filter(smallerCountBins==">90")
min(tss_s$rpd)
max(tss_s$rpd)
min(cu_s$rpd)
max(cu_s$rpd)
min(tp_s$rpd)
max(tp_s$rpd)
extreme_stats <- plot_data_gt90 %>%
group_by(facet_group, Quartile) %>%
summarize(min_rpd = min(rpd), max_rpd = max(rpd))
N_stats <- plot_data_gt90 %>%
group_by(facet_group, smallerCountBins) %>%
summarize(min_rpd = min(rpd), max_rpd = max(rpd))
# --- 6. Plot ---
### mean across all bins for # events in parent dataset
set.seed(36)  # ensures reproducible jitter positions for geom_point
plot_data %>%
mutate(Quartile = case_when(
Quartile == 0.1 ~ "10th Percentile",
Quartile == 0.25 ~ "25th Percentile",
Quartile == 0.5 ~ "50th Percentile",
Quartile == 0.75 ~ "75th Percentile",
Quartile == 0.9 ~ "90th Percentile"
)) %>%
ggplot(aes(x = N_numerical, y = rpd, color = smallerCountBins, group = smallerCountBins)) +
geom_line(stat = "smooth", method = "lm", se = FALSE, formula = y ~ I(log(x)), alpha = 0.7, size = 1.5) +
geom_errorbar(aes(ymin = rpd - sd, ymax = rpd + sd), width = 0.2, size = 1.5,
position = position_jitter(width = 0.1, height = 0, seed = 38)) +
geom_point(aes(shape = smallerCountBins), size = 7, fill = NA, stroke = 2,
position = position_jitter(width = 0.1, height = 0, seed = 38)) +
scale_shape_manual(name = "Number of Events in Parent Dataset",
labels = c("20-30", "31-60", "61-90", ">90", "All bins"),
values = c(16, 17, 15, 4, 18)) + # solid shapes
facet_grid(Quartile~facet_group) +
scale_y_continuous(breaks = seq(0, 60, 20), minor_breaks = seq(0, 70, 10)) +
coord_cartesian(ylim = c(0,71)) +
xlab("Number of Monitored Events in Data Subset") +
ylab("Mean Relative Percent Difference (%)") +
theme_bw(base_size = 40) +  theme(strip.placement = "outside", panel.spacing = unit(1, "lines"), strip.background = element_blank()) + theme(legend.position = "top", legend.box = "vertical") +
guides(fill = "none") +
scale_color_manual(name = "Number of Events in Parent Dataset",
labels = c("20-30", "31-60", "61-90", ">90", "All bins"),
values = c("#C7E9B4", "#41B6C4", "#225EA8","#081D58","grey10")) +
theme(legend.position = "top") +
theme(panel.grid.minor = element_line(color = "grey75", linewidth = 0.7),
panel.grid.major = element_line(color = "grey75", linewidth = 0.7),
axis.text.x = element_text(angle = 45, hjust = 1),
strip.text = element_text(face = "bold")
)
ggsave(here::here("Plots", "Final", "num_samples_analyte_PFlow_summary_aggregated_20260619.jpg"), width = 66, height = 70, units = "cm")
